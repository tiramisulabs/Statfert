{
  "name": "statfert",
  "version": "0.0.2",
  "license": "MIT",
  "type": "module",
  "private": false,
  "description": "Statcord for Seyfert",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiramisulabs/Statfert.git"
  },
  "keywords": [
    "discord",
    "seyfert",
    "statcord",
    "bot",
    "stats"
  ],
  "readme": "README.md",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "xo src tests",
    "prepack": "npm run build",
    "test": "bun test && bun run test:types && bun run test:node",
    "test:node": "npm run build && node --eval \"import('./dist/index.js')\"",
    "test:types": "tsc --noEmit --project tests/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "seyfert": "^5.0.0",
    "typescript": "^6.0.3",
    "xo": "^1.2.3"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "type-fest": "^5.4.4",
    "undici": "^7.21.0"
  },
  "peerDependencies": {
    "seyfert": ">=5.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
